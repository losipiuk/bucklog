<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window background matches the app surface, so startup doesn't flash white in dark mode. -->
    <style name="Theme.Bucklog" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Quick add: see-through, so the app underneath stays visible; the panel draws its own dimming. -->
    <style name="Theme.Bucklog.QuickAdd" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
