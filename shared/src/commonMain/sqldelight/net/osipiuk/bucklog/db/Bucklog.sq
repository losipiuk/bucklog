-- Local working copy of the family sheet (SPEC §7).

CREATE TABLE entry (
    id TEXT NOT NULL PRIMARY KEY,
    ts INTEGER NOT NULL,              -- epoch millis
    who TEXT NOT NULL,
    what TEXT NOT NULL,
    category TEXT NOT NULL,
    amount_minor INTEGER NOT NULL,    -- 3530 = 35.30; negative = refund
    currency TEXT NOT NULL,
    rate TEXT,                        -- to main currency; NULL = main currency or not fetched yet
    status TEXT NOT NULL,             -- PENDING | SYNCED | INVALID
    raw_json TEXT,                    -- original cells of an unparseable sheet row
    in_sheet INTEGER NOT NULL DEFAULT 0 -- 1 once the row is known to exist in the sheet
);

CREATE INDEX entry_ts ON entry(ts DESC);

-- Local changes not yet written to the sheet, applied in seq order.
CREATE TABLE outbox (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    op TEXT NOT NULL,                 -- UPSERT | DELETE (entries) | ADD_CATEGORY | UPDATE_CATEGORY
    entry_id TEXT NOT NULL,           -- entry ID, or the category's name in the sheet for category ops
    attempts INTEGER NOT NULL DEFAULT 0,
    last_error TEXT,
    payload TEXT                      -- UPDATE_CATEGORY: JSON with the new name, emoji and archived flag
);

CREATE TABLE category (
    name TEXT NOT NULL PRIMARY KEY,
    emoji TEXT,
    archived INTEGER NOT NULL DEFAULT 0,
    position INTEGER NOT NULL
);

CREATE TABLE fx_rate (
    currency TEXT NOT NULL,
    date TEXT NOT NULL,
    rate TEXT NOT NULL,
    PRIMARY KEY (currency, date)
);

CREATE TABLE setting (
    name TEXT NOT NULL PRIMARY KEY,
    content TEXT NOT NULL
);

insertEntry:
INSERT OR REPLACE INTO entry(id, ts, who, what, category, amount_minor, currency, rate, status, raw_json, in_sheet)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

entryById:
SELECT * FROM entry WHERE id = ?;

allEntries:
SELECT * FROM entry ORDER BY ts DESC;

updateEntry:
UPDATE entry SET ts = ?, who = ?, what = ?, category = ?, amount_minor = ?, currency = ?, rate = ?, status = 'PENDING'
WHERE id = ?;

isInSheet:
SELECT in_sheet FROM entry WHERE id = ?;

entryIdsWithCategory:
SELECT id FROM entry WHERE category = ?;

recategorize:
UPDATE entry SET category = ?, status = 'PENDING' WHERE category = ?;

entryIdsByWho:
SELECT id FROM entry WHERE who = ? AND status != 'INVALID';

renameWho:
UPDATE entry SET who = ?, status = 'PENDING' WHERE who = ? AND status != 'INVALID';

knownPeople:
SELECT who FROM entry WHERE who != '' GROUP BY who ORDER BY max(ts) DESC;

entryIdsInSheet:
SELECT id FROM entry WHERE in_sheet = 1;

deleteEntry:
DELETE FROM entry WHERE id = ?;

entriesMissingRate:
SELECT id, ts, currency FROM entry WHERE currency != ? AND rate IS NULL AND status != 'INVALID';

setRate:
UPDATE entry SET rate = ?, status = 'PENDING' WHERE id = ?;

markSynced:
UPDATE entry SET status = 'SYNCED', in_sheet = 1 WHERE id = ?;

recentEntries:
SELECT * FROM entry ORDER BY ts DESC LIMIT ?;

historyItems:
SELECT what, category, who, ts FROM entry WHERE status != 'INVALID';

recentCurrencies:
SELECT currency FROM entry GROUP BY currency ORDER BY max(ts) DESC LIMIT ?;

enqueue:
INSERT INTO outbox(op, entry_id) VALUES (?, ?);

enqueueWithPayload:
INSERT INTO outbox(op, entry_id, payload) VALUES (?, ?, ?);

categoryOps:
SELECT seq, op, entry_id, payload FROM outbox WHERE op IN ('ADD_CATEGORY', 'UPDATE_CATEGORY') ORDER BY seq;

outboxSize:
SELECT count(*) FROM outbox;

pendingEntryOps:
SELECT seq, op, entry_id FROM outbox WHERE op IN ('UPSERT', 'DELETE') ORDER BY seq;

deleteEntryOpsUpTo:
DELETE FROM outbox WHERE op IN ('UPSERT', 'DELETE') AND seq <= ?;

deleteEntryOpsFor:
DELETE FROM outbox WHERE op IN ('UPSERT', 'DELETE') AND entry_id = ?;

pendingCount:
SELECT count(*) FROM outbox;

outboxByOp:
SELECT seq, entry_id FROM outbox WHERE op = ? ORDER BY seq;

deleteOutbox:
DELETE FROM outbox WHERE seq = ?;

recordOutboxFailure:
UPDATE outbox SET attempts = attempts + 1, last_error = ? WHERE seq = ?;

categories:
SELECT * FROM category ORDER BY position;

deleteCategories:
DELETE FROM category;

insertCategory:
INSERT OR REPLACE INTO category(name, emoji, archived, position) VALUES (?, ?, ?, ?);

categoryPosition:
SELECT position FROM category WHERE name = ?;

deleteCategory:
DELETE FROM category WHERE name = ?;

nextCategoryPosition:
SELECT coalesce(max(position) + 1, 0) FROM category;

getValue:
SELECT content FROM setting WHERE name = ?;

deleteValue:
DELETE FROM setting WHERE name = ?;

getRate:
SELECT rate FROM fx_rate WHERE currency = ? AND date = ?;

putRate:
INSERT OR REPLACE INTO fx_rate(currency, date, rate) VALUES (?, ?, ?);

putValue:
INSERT OR REPLACE INTO setting(name, content) VALUES (?, ?);

allValues:
SELECT * FROM setting;

clearValues:
DELETE FROM setting;

clearSheetValues:
DELETE FROM setting WHERE name IN ('spreadsheet_id', 'spreadsheet_name', 'main_currency', 'time_zone') OR name LIKE 'sync_%';

clearEntries:
DELETE FROM entry;

clearOutbox:
DELETE FROM outbox;
